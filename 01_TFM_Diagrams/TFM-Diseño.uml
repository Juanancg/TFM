          <subvertex xmi:type="uml:State" xmi:id="_HY9SsIi9EeqxVdboc4aDZQ" name="checkNearElemWithDestination">
            <doActivity xmi:type="uml:OpaqueBehavior" xmi:id="_f6OCAIi9EeqxVdboc4aDZQ">
              <language>C</language>
              <body>if (near_elem == goal) {&#xD;
	achieved = true;&#xD;
}</body>
