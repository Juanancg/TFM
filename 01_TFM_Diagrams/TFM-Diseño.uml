          <ownedComment xmi:type="uml:Comment" xmi:id="_mRw9cIi-EeqxVdboc4aDZQ">
            <body>st_cell {&#xD;
	int x;&#xD;
	int y;&#xD;
	ENUM state;&#xD;
}&#xD;
-&#xD;
st_cell_queue {&#xD;
	st_cell cell_array[50];&#xD;
	int length;&#xD;
}&#xD;
-&#xD;
E_CELL_STATE {&#xD;
       E_UNABLE;&#xD;
	E_UNVISITED;&#xD;
       E_VISITED;&#xD;
}&#xD;
	&#xD;
&#xD;
</body>
          </ownedComment>
          <ownedComment xmi:type="uml:Comment" xmi:id="_AWhlkIkcEeqnmbh8CdaLdw">
            <body>Action = movimiento a realizar:&#xD;
Action = 0 -> x + 1 (Derecha)&#xD;
Action = 1 -> y + 1 (Arriba)&#xD;
Action = 2 -> x - 1 (Izquierda)&#xD;
Action = 3 -> y - 1 (Abajo)</body>
          </ownedComment>
