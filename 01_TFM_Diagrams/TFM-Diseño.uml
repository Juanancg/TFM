          </subvertex>
          <subvertex xmi:type="uml:State" xmi:id="_R07kYIfjEeq2zqZjD6cexQ" name="takeMeasuremets">
            <doActivity xmi:type="uml:OpaqueBehavior" xmi:id="_R07kYYfjEeq2zqZjD6cexQ">
              <language>C</language>
              <body>for (unsigned int i = 0; i  &lt; 10; i++) {&#xD;
	uart[i] = U1TXREG;&#xD;
}&#xD;
distance[totalMeasurements] = uart[2] + uart[3] * 256;&#xD;
totalMeasurements++&#xD;
if (totalMeasurements==3) {&#xD;
exit = true&#xD;
}</body>
            </doActivity>
            <entry xmi:type="uml:OpaqueBehavior" xmi:id="_R07kYofjEeq2zqZjD6cexQ">
              <language>C</language>
              <body>totalMeasurements = 0&#xD;
exit = false&#xD;
int uart[9];&#xD;
int distance[3];</body>
            </entry>
            <exit xmi:type="uml:OpaqueBehavior" xmi:id="_R07kY4fjEeq2zqZjD6cexQ">
              <language>C</language>
              <body>saves result&#xD;
</body>
            </exit>
          </subvertex>
          <subvertex xmi:type="uml:State" xmi:id="_ia87cIfjEeq2zqZjD6cexQ" name="computeMean">
            <entry xmi:type="uml:OpaqueBehavior" xmi:id="_ia87cYfjEeq2zqZjD6cexQ">
              <language>C</language>
              <body>returnValue = (distance1 + distance 2 + distance 3 )/ totalMeasurements</body>
            </entry>
          </subvertex>
          <subvertex xmi:type="uml:FinalState" xmi:id="_1L__oIfjEeq2zqZjD6cexQ" name="FinalState14"/>
        </region>
      </packagedElement>
      <packagedElement xmi:type="uml:StateMachine" xmi:id="_MRGHYIfuEeqzIuR0cO0JcQ" name="getNearElementToDestination">
        <region xmi:type="uml:Region" xmi:id="_PatjsIfuEeqzIuR0cO0JcQ" name="Region1">
          <transition xmi:type="uml:Transition" xmi:id="_e24LIIi8EeqxVdboc4aDZQ" source="_WtTyIIfvEeqzIuR0cO0JcQ" target="_PoNiQIfwEeqzIuR0cO0JcQ"/>
          <transition xmi:type="uml:Transition" xmi:id="_gJVRgIi8EeqxVdboc4aDZQ" source="_PoNiQIfwEeqzIuR0cO0JcQ" target="_YYmPQIfvEeqzIuR0cO0JcQ"/>
          <subvertex xmi:type="uml:Pseudostate" xmi:id="_WtTyIIfvEeqzIuR0cO0JcQ" name="Initial1"/>
          <subvertex xmi:type="uml:State" xmi:id="_YYmPQIfvEeqzIuR0cO0JcQ" name="checkIfCellisVisited">
            <doActivity xmi:type="uml:OpaqueBehavior" xmi:id="_vCsPUIf0EeqzIuR0cO0JcQ">
              <language>C</language>
              <body>if (queue[i].state == VISITED) {&#xD;
	state_visited =true;&#xD;
}</body>
            </doActivity>
            <entry xmi:type="uml:OpaqueBehavior" xmi:id="_dEUasIfzEeqzIuR0cO0JcQ">
              <language>C</language>
              <body>state_visited = false;</body>
            </entry>
          </subvertex>
          <subvertex xmi:type="uml:State" xmi:id="_PoNiQIfwEeqzIuR0cO0JcQ" name="initializeVariables">
            <entry xmi:type="uml:OpaqueBehavior" xmi:id="_VKwvYIfxEeqzIuR0cO0JcQ">
              <language>C</language>
              <body>st_cell returnValue;&#xD;
double distance = 0;&#xD;
double temp_distance = 0;&#xD;
bool first_distance = true;&#xD;
int near_point = 0;&#xD;
int i = 0;</body>
            </entry>
          </subvertex>
          <subvertex xmi:type="uml:State" xmi:id="__Qc-wIfxEeqzIuR0cO0JcQ" name="getDistance">
            <entry xmi:type="uml:OpaqueBehavior" xmi:id="_ZX060IfzEeqzIuR0cO0JcQ">
              <language>C</language>
              <body>temp_distance = sqrt(pow(queue[i].x - destination.x, 2) + pow(queue[i].y - destination.y, 2));</body>
            </entry>
          </subvertex>
          <subvertex xmi:type="uml:State" xmi:id="_7Ac6YIi7EeqxVdboc4aDZQ" name="checkDistance"/>
          <subvertex xmi:type="uml:State" xmi:id="_SPWC4Ii8EeqxVdboc4aDZQ" name="saves_distance"/>
        </region>
      </packagedElement>
    </packagedElement>
