          <subvertex xmi:type="uml:State" xmi:id="_5Ry2sIfrEeqzdcmLo1mxFQ" name="CreatePathAndQueue">
            <entry xmi:type="uml:OpaqueBehavior" xmi:id="_z6NRgIfsEeqzdcmLo1mxFQ">
              <language>C</language>
              <body>st_cell_queue queue; // length 50&#xD;
st_cell_queue path;    // length 50&#xD;
queue[0].x = goal_x; &#xD;
queue[0].y = goal_y;&#xD;
queue[0].state = E_STATE_VISITED;&#xD;
int action = 0;</body>
            </entry>
          </subvertex>
