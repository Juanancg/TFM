          <subvertex xmi:type="uml:Pseudostate" xmi:id="_kN_-kIIeEeqBrv4lwx0DVw" name="Initial1"/>
          <subvertex xmi:type="uml:State" xmi:id="_nMtycIIeEeqBrv4lwx0DVw" name="getAnglesToPWM">
            <entry xmi:type="uml:OpaqueBehavior" xmi:id="_Zy1x0IIfEeqBrv4lwx0DVw">
              <language>C</language>
              <body>Pasar angulo a pulsos</body>
            </entry>
          </subvertex>
          <subvertex xmi:type="uml:FinalState" xmi:id="_6GgGcIIfEeqBrv4lwx0DVw" name="FinalState3">
            <exit xmi:type="uml:OpaqueBehavior" xmi:id="_y3xDUIIpEeqBrv4lwx0DVw">
              <language>C</language>
              <body>Distance = 0&#xD;
return FALSE</body>
            </exit>
