          <subvertex xmi:type="uml:State" xmi:id="_EjseMIfrEeqzdcmLo1mxFQ" name="CheckDestination">
            <doActivity xmi:type="uml:OpaqueBehavior" xmi:id="_c8ZucIfrEeqzdcmLo1mxFQ">
              <language>C</language>
              <body>if(map[goal_x][goal_y].state == DISABLED) {&#xD;
