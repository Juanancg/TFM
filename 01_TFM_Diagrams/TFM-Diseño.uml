          <subvertex xmi:type="uml:State" xmi:id="_PWXK4IIqEeqBrv4lwx0DVw" name="moveServo">
            <doActivity xmi:type="uml:OpaqueBehavior" xmi:id="_fCZl8IIqEeqBrv4lwx0DVw">
              <language>C</language>
              <body>wait(630ms)//Ver tiempo del fabricante y sumarle unos ms HITECH (NO es el mismo pero es parecido al nuestro)&#xD;
</body>
            </doActivity>
            <entry xmi:type="uml:OpaqueBehavior" xmi:id="_V9U30IIqEeqBrv4lwx0DVw">
              <language>C</language>
              <body>send PWM signal&#xD;
</body>
            </entry>
          </subvertex>
          <subvertex xmi:type="uml:State" xmi:id="_lPy8UIIqEeqBrv4lwx0DVw" name="takeMeasuremetsUltraSonic">
            <doActivity xmi:type="uml:OpaqueBehavior" xmi:id="_XW75oIIrEeqBrv4lwx0DVw">
              <language>C</language>
              <body>sendSignalLidar&#xD;
activarTimer / Alarma&#xD;
wait()&#xD;
receive signal&#xD;
calcular distancia (d = vel_ligth * tiempo / 2)&#xD;
totalMeasurements++&#xD;
if (totalMeasurements==3) {&#xD;
exit = true&#xD;
}</body>
            </doActivity>
            <entry xmi:type="uml:OpaqueBehavior" xmi:id="_2JOXkIIqEeqBrv4lwx0DVw">
              <language>C</language>
              <body>totalMeasurements = 0&#xD;
exit = false</body>
            </entry>
            <exit xmi:type="uml:OpaqueBehavior" xmi:id="_LA7JwIIsEeqBrv4lwx0DVw">
              <language>C</language>
              <body>saves result&#xD;
</body>
            </exit>
          </subvertex>
          <subvertex xmi:type="uml:State" xmi:id="_fPTuoIIsEeqBrv4lwx0DVw" name="computeMean">
            <entry xmi:type="uml:OpaqueBehavior" xmi:id="_sSvIsIIsEeqBrv4lwx0DVw">
              <language>C</language>
              <body>returnValue = (distance1 + distance 2 + distance 3 )/ totalMeasurements</body>
            </entry>
          </subvertex>
          <subvertex xmi:type="uml:FinalState" xmi:id="_5CTR8II0EeqBrv4lwx0DVw" name="FinalState13"/>
          <subvertex xmi:type="uml:State" xmi:id="_nzmU4IZTEeq5BIWtMiL_ug" name="CheckInputAngle">
            <doActivity xmi:type="uml:OpaqueBehavior" xmi:id="_CQjU0IZUEeq5BIWtMiL_ug">
