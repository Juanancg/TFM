  <packagedElement xmi:type="uml:StateMachine" xmi:id="_A7KRsH2tEeqLtO18OMgg9Q" name="Planning">
    <region xmi:type="uml:Region" xmi:id="_B1CgAH2tEeqLtO18OMgg9Q" name="Region1">
      <ownedComment xmi:type="uml:Comment" xmi:id="_1_hswH27EeqLtO18OMgg9Q">
        <body>Action = movimiento a realizar:&#xD;
Action = 0 -> x + 1 (Derecha)&#xD;
Action = 1 -> y + 1 (Arriba)&#xD;
Action = 2 -> x - 1 (Izquierda)&#xD;
Action = 3 -> y - 1 (Abajo)</body>
      </ownedComment>
      <transition xmi:type="uml:Transition" xmi:id="__YxccH2tEeqLtO18OMgg9Q" name="Destino alcanzable" source="_U7yucH2tEeqLtO18OMgg9Q" target="_7Kv80H2tEeqLtO18OMgg9Q"/>
      <transition xmi:type="uml:Transition" xmi:id="_D4xc4H2uEeqLtO18OMgg9Q" source="_G43mQH2tEeqLtO18OMgg9Q" target="_U7yucH2tEeqLtO18OMgg9Q"/>
      <transition xmi:type="uml:Transition" xmi:id="_HTt5wH2uEeqLtO18OMgg9Q" name="Destino no alcanzable" source="_U7yucH2tEeqLtO18OMgg9Q" target="_Fh7zEH2uEeqLtO18OMgg9Q"/>
      <transition xmi:type="uml:Transition" xmi:id="_i6dMQH2uEeqLtO18OMgg9Q" source="_7Kv80H2tEeqLtO18OMgg9Q" target="_eywXEH2uEeqLtO18OMgg9Q"/>
      <transition xmi:type="uml:Transition" xmi:id="_xWVxkH2vEeqLtO18OMgg9Q" name="temp_cell != Destination" source="_eywXEH2uEeqLtO18OMgg9Q" target="_ouwQsH2vEeqLtO18OMgg9Q"/>
      <transition xmi:type="uml:Transition" xmi:id="_6dUkMH2vEeqLtO18OMgg9Q" name="temp_cell == Destination" source="_eywXEH2uEeqLtO18OMgg9Q" target="_3Ni1gH2vEeqLtO18OMgg9Q"/>
      <transition xmi:type="uml:Transition" xmi:id="_jee-AH28EeqLtO18OMgg9Q" name="Accion &lt; 4" source="_ouwQsH2vEeqLtO18OMgg9Q" target="_WgqcsH28EeqLtO18OMgg9Q"/>
      <transition xmi:type="uml:Transition" xmi:id="_AmbkkH29EeqLtO18OMgg9Q" name="Accion = 4" source="_ouwQsH2vEeqLtO18OMgg9Q" target="_eywXEH2uEeqLtO18OMgg9Q"/>
      <transition xmi:type="uml:Transition" xmi:id="_xpywsH29EeqLtO18OMgg9Q" name="Celda obtenida fuera de los limites" source="_WgqcsH28EeqLtO18OMgg9Q" target="_ouwQsH2vEeqLtO18OMgg9Q"/>
      <subvertex xmi:type="uml:Pseudostate" xmi:id="_G43mQH2tEeqLtO18OMgg9Q" name="LLamada Funcion"/>
      <subvertex xmi:type="uml:State" xmi:id="_U7yucH2tEeqLtO18OMgg9Q" name="CheckDestination">
        <entry xmi:type="uml:FunctionBehavior" xmi:id="_x1ePgH2tEeqLtO18OMgg9Q" name="Comprobar dentro del mapa si el destino es alcanzable (Hacer Diagrama de estados de esta funcion)"/>
      </subvertex>
      <subvertex xmi:type="uml:State" xmi:id="_7Kv80H2tEeqLtO18OMgg9Q" name="CreateQueue &amp; Path">
        <doActivity xmi:type="uml:FunctionBehavior" xmi:id="_W8-toH2uEeqLtO18OMgg9Q" name="Inicializar queue con posicion inicial"/>
        <entry xmi:type="uml:FunctionBehavior" xmi:id="_PkUeAH2uEeqLtO18OMgg9Q" name="Crear dos arrays de &quot;celdas&quot;, uno para ir guardando el path final(&quot;Path&quot;) y otro para ir guardando posibles movimientos(&quot;QUEUE&quot;)"/>
      </subvertex>
      <subvertex xmi:type="uml:FinalState" xmi:id="_Fh7zEH2uEeqLtO18OMgg9Q" name="return False"/>
      <subvertex xmi:type="uml:State" xmi:id="_eywXEH2uEeqLtO18OMgg9Q" name="GetNearElement from QUEUE">
        <doActivity xmi:type="uml:FunctionBehavior" xmi:id="_BPi7YH2vEeqLtO18OMgg9Q" name="Obtener distancias de los elementos de QUEUE y sacar aquel con la menor distancia hacia el objetivo"/>
        <entry xmi:type="uml:FunctionBehavior" xmi:id="_6U-V8H2uEeqLtO18OMgg9Q" name="Declarar temp_dist y minimum_distance"/>
        <exit xmi:type="uml:FunctionBehavior" xmi:id="_GNFMYH2vEeqLtO18OMgg9Q" name="Guardar celda mas cercana al objetivo en variable (&quot;temp_cell&quot;) y dentro de PATH"/>
      </subvertex>
      <subvertex xmi:type="uml:State" xmi:id="_ouwQsH2vEeqLtO18OMgg9Q" name="Definir Accion">
        <entry xmi:type="uml:FunctionBehavior" xmi:id="_gNa14H28EeqLtO18OMgg9Q" name="Definir accion a realizar (Accion+1)"/>
      </subvertex>
      <subvertex xmi:type="uml:FinalState" xmi:id="_3Ni1gH2vEeqLtO18OMgg9Q" name="return True &amp; PATH"/>
      <subvertex xmi:type="uml:State" xmi:id="_WgqcsH28EeqLtO18OMgg9Q" name="move(Action)">
        <doActivity xmi:type="uml:FunctionBehavior" xmi:id="_WgqcsX28EeqLtO18OMgg9Q" name="check si ese movimiento no se sale de los limites"/>
        <entry xmi:type="uml:FunctionBehavior" xmi:id="_Wgqcsn28EeqLtO18OMgg9Q" name="Definir siguiente movimiento desde temp_cell"/>
        <exit xmi:type="uml:FunctionBehavior" xmi:id="_Wgqcs328EeqLtO18OMgg9Q" name="Devolver siguiente celda &amp; True or False dependiendo si se sale de los limites o no"/>
      </subvertex>
      <subvertex xmi:type="uml:State" xmi:id="_Gp4UwH29EeqLtO18OMgg9Q" name="State18"/>
    </region>
  </packagedElement>
